{
	"name": "fp-agency-site",
	"compatibility_date": "2026-07-03",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"vars": {
		"PUBLIC_API_BASE": "https://api.fpagency.com.br"
	},
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "19e32507201041dfbd823a1afb83a2ff"
		}
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	"observability": {
		"enabled": true
	}
}
