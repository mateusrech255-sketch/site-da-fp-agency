---
interface Props {
  videoId: string;
}

const { videoId } = Astro.props;
---

<div class="video-player-container">
  {/* O Astro injeta a variável do servidor direto no script do navegador */}
  <script is:inline define:vars={{ videoId }}>
    (window.openVideoPlayers = window.openVideoPlayers || []).push({
      allowPlaylistAds: false,
      target: document.currentScript,
      videoID: videoId
    });
  </script>
  <script is:inline async src="https://open.video/video.js"></script>
  <script is:inline>
    (() => {
      const playerRoot = document.currentScript?.closest('.video-player-container');
      if (!playerRoot) return;

      const removeShareControls = () => {
        // Remove explicitly known share/redirect buttons
        playerRoot
          .querySelectorAll('.vjs-share-control, .vignette-top-share, #vignette-top-button')
          .forEach((element) => element.remove());

        playerRoot.querySelectorAll('.video-js').forEach((element) => {
          element.classList.remove('vjs-share', 'vjs-videojs-share');
        });

        // Block any <a> tags that lead outside by replacing them with <div>
        playerRoot.querySelectorAll('a').forEach((a) => {
          if (a.href && (a.href.includes('academy.fpagency.com.br') || a.href.includes('open.video'))) {
            const div = document.createElement('div');
            // Copy all attributes except href and target
            Array.from(a.attributes).forEach(attr => {
              if (attr.name !== 'href' && attr.name !== 'target') {
                div.setAttribute(attr.name, attr.value);
              }
            });
            // Move all children to the new div
            while (a.firstChild) {
              div.appendChild(a.firstChild);
            }
            // Replace the <a> with the new <div> in the DOM
            if (a.parentNode) {
              a.parentNode.replaceChild(div, a);
            }
          }
        });
      };

      removeShareControls();

      const observer = new MutationObserver(removeShareControls);
      observer.observe(playerRoot, { childList: true, subtree: true });
      window.addEventListener('pagehide', () => observer.disconnect(), { once: true });
    })();

    // Globally intercept window.open for the player to prevent new tabs
    if (!window.__openVideoIntercepted) {
      window.__openVideoIntercepted = true;
      const originalOpen = window.open;
      window.open = function(url, name, specs) {
        if (typeof url === 'string' && (url.includes('academy.fpagency.com.br') || url.includes('open.video'))) {
          console.warn('Bloqueando redirecionamento externo para:', url);
          return null;
        }
        return originalOpen.apply(this, arguments);
      };
    }
  </script>
</div>

<style is:global>
  .video-player-container {
    width: min(100%, 420px);
    aspect-ratio: 9 / 16;
    margin: 0 auto;
    background-color: #000;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0,0,0,0.3);
  }

  .video-player-container .ez-video-embed-container,
  .video-player-container .ez-video-wrap,
  .video-player-container .ez-video-center,
  .video-player-container .ez-video-content-wrap,
  .video-player-container .ez-video-container,
  .video-player-container .video-js {
    width: 100%;
    height: 100%;
    max-height: 100%;
  }

  .video-player-container .vjs-tech,
  .video-player-container .vjs-poster img,
  .video-player-container .video-poster,
  .video-player-container #floating-placeholder-thumbnail {
    object-fit: contain !important;
  }

  .video-player-container .vjs-share-control,
  .video-player-container .vignette-top-share,
  .video-player-container #vignette-top-button {
    display: none !important;
  }
</style>
