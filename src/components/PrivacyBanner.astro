---
---

<div id="privacy-banner" class="privacy-banner hidden">
  <div class="privacy-banner-header">
    <div class="privacy-icon">
      <i class="fas fa-cookie-bite"></i>
    </div>
    <h3>Sua Privacidade</h3>
  </div>
  
  <div class="privacy-banner-content">
    <p>
      Utilizamos cookies para personalizar sua experiência e anúncios. Ao continuar, você concorda com a nossa 
      <a href="/politica-de-privacidade">Política de Privacidade</a> e 
      <a href="/termos-de-servico">Termos de Serviço</a>.
    </p>
  </div>
  
  <button id="accept-privacy" class="privacy-btn">
    Entendi e Aceito
  </button>
</div>

<style>
  .privacy-banner {
    position: fixed;
    bottom: 90px; /* Acima do botão do WhatsApp no mobile */
    left: 20px;
    right: 20px;
    background-color: var(--bg-2);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 20px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
    z-index: 9998;
    display: flex;
    flex-direction: column;
    gap: 15px;
    transform: translateY(150%);
    opacity: 0;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.5s ease;
  }

  .privacy-banner.show {
    transform: translateY(0);
    opacity: 1;
  }

  .privacy-banner.hidden {
    display: none;
  }

  .privacy-banner-header {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .privacy-icon {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: rgba(255, 107, 43, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--orange);
    font-size: 1.2rem;
  }

  .privacy-banner-header h3 {
    color: var(--text);
    font-size: 1.1rem;
    margin: 0;
    font-weight: 600;
  }

  .privacy-banner-content p {
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.5;
    margin: 0;
  }

  .privacy-banner-content a {
    color: var(--orange);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }

  .privacy-banner-content a:hover {
    color: var(--gold);
    text-decoration: underline;
  }

  .privacy-btn {
    background-color: var(--orange);
    color: #fff;
    border: none;
    padding: 12px 20px;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s, transform 0.1s;
    width: 100%;
    margin-top: 5px;
  }

  .privacy-btn:hover {
    background-color: var(--orange2);
  }

  .privacy-btn:active {
    transform: scale(0.98);
  }

  /* Desktop layout */
  @media (min-width: 768px) {
    .privacy-banner {
      bottom: 30px;
      left: 30px;
      right: auto;
      width: 380px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const banner = document.getElementById('privacy-banner');
    const acceptBtn = document.getElementById('accept-privacy');
    
    if (banner && acceptBtn) {
      if (!localStorage.getItem('privacy_accepted_v2')) {
        // Remove 'hidden' so it renders, then trigger animation
        banner.classList.remove('hidden');
        // Force reflow
        void banner.offsetWidth;
        banner.classList.add('show');
      }
      
      acceptBtn.addEventListener('click', () => {
        localStorage.setItem('privacy_accepted_v2', 'true');
        banner.classList.remove('show');
        
        // Esconde completamente após a animação de saída
        setTimeout(() => {
          banner.classList.add('hidden');
        }, 500);
      });
    }
  });
</script>
