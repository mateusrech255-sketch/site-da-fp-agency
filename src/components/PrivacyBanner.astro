<div id="privacy-banner" class="fixed bottom-0 left-0 w-full bg-slate-900 border-t border-slate-800 p-4 md:p-6 shadow-2xl z-[9999] transform translate-y-full transition-transform duration-500 ease-in-out hidden">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
    <div class="flex-1 text-slate-300 text-sm">
      <p>
        Nós utilizamos cookies e outras tecnologias para melhorar a sua experiência, personalizar anúncios e garantir a segurança do nosso site. 
        Ao continuar navegando, você concorda com a nossa 
        <a href="/politica-privacidade" class="text-orange-500 hover:text-orange-400 underline decoration-orange-500/30">Política de Privacidade</a> e 
        <a href="/termos-de-uso" class="text-orange-500 hover:text-orange-400 underline decoration-orange-500/30">Termos de Uso</a>.
      </p>
    </div>
    <div class="flex-shrink-0 w-full md:w-auto">
      <button id="accept-privacy" class="w-full md:w-auto px-6 py-2.5 bg-orange-600 hover:bg-orange-500 text-white font-medium rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-orange-500/50 cursor-pointer">
        Entendi e Aceito
      </button>
    </div>
  </div>
</div>

<script>
  // Verifica se o usuário já aceitou
  document.addEventListener('DOMContentLoaded', () => {
    const banner = document.getElementById('privacy-banner');
    const acceptBtn = document.getElementById('accept-privacy');
    
    if (banner && acceptBtn) {
      // Se não tiver o registro no localStorage, mostra o banner
      if (!localStorage.getItem('privacy_accepted')) {
        // Remove o hidden primeiro
        banner.classList.remove('hidden');
        // Pequeno delay para a transição de CSS funcionar
        setTimeout(() => {
          banner.classList.remove('translate-y-full');
        }, 100);
      }
      
      // Quando clicar em aceitar
      acceptBtn.addEventListener('click', () => {
        // Salva no localStorage
        localStorage.setItem('privacy_accepted', 'true');
        
        // Animação de descida
        banner.classList.add('translate-y-full');
        
        // Esconde completamente após a animação
        setTimeout(() => {
          banner.classList.add('hidden');
        }, 500);
      });
    }
  });
</script>
