---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import data from '../../data/videos.json';
import { Image } from 'astro:assets';
import { withBasePath } from '../../lib/site-path';

const sitePath = (path: string) => withBasePath(path, import.meta.env.BASE_URL);

interface Video {
  id: string;
  slug: string;
  title: string;
  description: string;
  thumbnail: string;
  duration?: string;
}

interface Course {
  id: string;
  title: string;
  description: string;
  tutor: string | null;
  videos: Video[];
}

const courses = data.courses as Course[];

const filterCourses = courses.map(course => {
  let filterText = course.title;
  if (filterText.includes('Narrastars —')) {
    filterText = filterText.replace('Narrastars —', 'Narrastars');
  } else if (filterText.includes('Tarefas Pagas —')) {
    filterText = filterText.replace('Tarefas Pagas —', 'Tarefas Pagas');
  }
  return { ...course, filterText };
});
---

<Layout title="Treinamento FP Agency">
  <Header />

  <main class="page-wrapper">
    <header class="page-header">
      <h1>Portal de Treinamento</h1>
      <p>Desenvolva suas habilidades com o método FP Agency.</p>
    </header>

    <div class="filter-container">
      <button class="filter-btn active" data-filter="all">Todos</button>
      {filterCourses.map(course => (
        <button class="filter-btn" data-filter={course.id}>{course.filterText}</button>
      ))}
    </div>

    <div class="courses-container">
      {courses.map((course, cIdx) => (
        <section class="course-section" id={course.id} data-course={course.id}>
          <div class="course-header">
            <h2>{course.title}</h2>
            {course.tutor && <p class="course-tutor">Tutor: {course.tutor}</p>}
            <p class="course-description">{course.description}</p>
            <p class="course-count">{course.videos.length} treinamentos</p>
          </div>
          
          <div class="video-grid">
            {course.videos.map((video, vIdx) => (
              <a href={sitePath(`/treinamento/${video.slug}`)} class="video-card">
                <div class="thumbnail-container">
                  <Image src={video.thumbnail} alt={video.title} width={360} height={640} loading={cIdx === 0 && vIdx < 6 ? "eager" : "lazy"} format="webp" />
                  <div class="play-overlay">
                    <div class="play-button">▶</div>
                  </div>
                  <div class="video-badges">
                    <span class="badge time-badge">{video.duration ? `${video.duration} min` : '10:00 min'}</span>
                  </div>
                </div>
                <div class="video-info">
                  <div class="meta-tags">
                    <span class="level-tag">{course.tutor ? course.tutor : 'FP Agency'}</span>
                  </div>
                  <h3>{video.title}</h3>
                  {video.description && <p>{video.description}</p>}
                </div>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </main>

  <Footer />
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const sections = document.querySelectorAll('.course-section');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        // Remove active class from all
        filterBtns.forEach(b => b.classList.remove('active'));
        // Add active class to clicked
        btn.classList.add('active');

        const filter = btn.getAttribute('data-filter');

        sections.forEach((section: any) => {
          if (filter === 'all' || section.getAttribute('data-course') === filter) {
            section.style.display = 'block';
          } else {
            section.style.display = 'none';
          }
        });
      });
    });
  });
</script>

<style>
  .page-wrapper { max-width: 1200px; margin: 0 auto; padding: 3rem 1.5rem; font-family: system-ui, sans-serif; }
  .page-header { text-align: center; margin-bottom: 2rem; }
  .page-header h1 { font-size: 2.5rem; color: #fff; margin-bottom: 0.5rem; }
  .page-header p { color: #a1a1aa; }
  
  .filter-container { display: flex; flex-wrap: nowrap; overflow-x: auto; gap: 0.75rem; justify-content: flex-start; margin-bottom: 3rem; padding-bottom: 0.5rem; scrollbar-width: none; }
  .filter-container::-webkit-scrollbar { display: none; }
  .filter-btn { white-space: nowrap; background: #18181b; color: #d4d4d8; border: 1px solid rgba(63, 63, 70, 0.6); padding: 0.5rem 1rem; border-radius: 9999px; font-size: 0.9rem; font-weight: 500; cursor: pointer; transition: all 0.2s ease; }
  .filter-btn:hover { border-color: #71717a; }
  .filter-btn.active { background: rgba(249, 115, 22, 0.1); color: #fb923c; border-color: #f97316; font-weight: 500; }

  @media (min-width: 768px) {
    .filter-container { flex-wrap: wrap; justify-content: center; overflow-x: visible; }
  }

  .course-section { margin-bottom: 4rem; padding-bottom: 3rem; border-bottom: 1px solid #27272a; }
  .course-section:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
  .course-header { margin-bottom: 2rem; }
  .course-header h2 { font-size: 2rem; color: #fff; margin: 0 0 0.5rem 0; }
  .course-tutor { font-size: 1.1rem; color: #ff4500; font-weight: 600; margin: 0 0 0.5rem 0; }
  .course-description { color: #a1a1aa; font-size: 1rem; margin: 0 0 0.75rem 0; max-width: 800px; line-height: 1.5; }
  .course-count { font-size: 0.9rem; color: #71717a; margin: 0; font-weight: 500; display: inline-block; background: #27272a; padding: 0.25rem 0.75rem; border-radius: 1rem; }
  
  .video-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr)); gap: 2rem; }
  
  .video-card { background-color: #18181b; border: 1px solid #27272a; border-radius: 12px; overflow: hidden; text-decoration: none; transition: all 0.2s ease; display: flex; align-items: flex-start; gap: 1.25rem; padding: 0.75rem; min-width: 0; min-height: 140px; }
  .video-card:hover { transform: translateY(-5px); border-color: #ff4500; box-shadow: 0 10px 25px rgba(255, 69, 0, 0.15); }
  
  .thumbnail-container { position: relative; flex: 0 0 clamp(110px, 35%, 160px); aspect-ratio: 9 / 16; overflow: hidden; background: #000; border-radius: 10px; }
  .thumbnail-container img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
  .video-card:hover .thumbnail-container img { transform: scale(1.05); }
  
  .video-badges { position: absolute; bottom: 0.5rem; right: 0.5rem; display: flex; gap: 0.25rem; }
  .time-badge { background: rgba(0,0,0,0.8); color: #fff; font-size: 0.75rem; font-weight: 600; padding: 0.15rem 0.4rem; border-radius: 4px; backdrop-filter: blur(4px); }

  .play-overlay { position: absolute; inset: 0; background: rgba(0,0,0,0.4); display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.2s; }
  .video-card:hover .play-overlay { opacity: 1; }
  .play-button { background: #ff4500; color: #fff; width: 44px; height: 44px; border-radius: 50%; display: flex; align-items: center; justify-content: center; padding-left: 4px; }
  
  .video-info { flex: 1 1 auto; min-width: 0; padding: 0.25rem 0.75rem 0.25rem 0; display: flex; flex-direction: column; justify-content: flex-start; }
  .meta-tags { margin-bottom: 0.5rem; display: flex; gap: 0.5rem; }
  .level-tag { font-size: 0.75rem; color: #d4d4d8; background: #27272a; padding: 0.15rem 0.5rem; border-radius: 4px; font-weight: 500; border: 1px solid #3f3f46; }
  
  .video-info h3 { font-size: 1.15rem; line-height: 1.3; color: #fff; margin: 0 0 0.5rem 0; overflow-wrap: anywhere; font-weight: 600; }
  .video-info p { font-size: 0.9rem; color: #a1a1aa; margin: 0; line-height: 1.4; overflow-wrap: anywhere; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

  @media (max-width: 480px) {
    .page-wrapper { padding: 2.5rem 1rem; }
    .page-header { margin-bottom: 2rem; }
    .page-header h1 { font-size: 2rem; }
    .course-header h2 { font-size: 1.75rem; }
    .course-section { margin-bottom: 3rem; padding-bottom: 2rem; }
    .video-grid { gap: 1rem; }
    .video-card { gap: 1rem; padding: 0.65rem; }
    .thumbnail-container { flex-basis: clamp(90px, 33%, 120px); }
    .video-info { padding: 0; }
    .video-info h3 { font-size: 1rem; }
    .video-info p { font-size: 0.84rem; line-height: 1.35; -webkit-line-clamp: 2; }
    .play-button { width: 38px; height: 38px; }
  }

  @media (max-width: 340px) {
    .page-wrapper { padding-inline: 0.75rem; }
    .video-card { gap: 0.75rem; padding: 0.55rem; }
    .thumbnail-container { flex-basis: 82px; }
  }
</style>
